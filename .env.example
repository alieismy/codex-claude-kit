# Optional MCP credential names. This file does not configure a client by itself.
# See docs/installation.md#environment-variables for process environment and OAuth setup.
# Some local servers load .env themselves; HTTP servers and clients need their documented setup.
# Keep real credentials out of Git and command output.

# Tavily: recommended web search/extraction MCP; omit when using OAuth instead.
# https://app.tavily.com/home
TAVILY_API_KEY=your_tavily_api_key

# Context7: optional library/framework/SDK documentation lookup.
# https://context7.com/dashboard
CONTEXT7_API_KEY=your_context7_api_key
