{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "enableAllProjectMcpServers": false,
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(secrets/**)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git tag *)",
      "Bash(npm publish *)",
      "Bash(rm *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(git tag *)",
      "PowerShell(npm publish *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean *)",
      "PowerShell(git checkout -- *)",
      "PowerShell(git restore *)"
    ]
  }
}
